{
  "appId": "uz.aicomp.yang.ide",
  "productName": "YANG IDE",
  "npmRebuild": false,
  "copyright": "AICOMP.UZ",
  "directories": {
    "output": "dist-ide"
  },
  "compression": "maximum",
  "electronLanguages": [
    "en-US",
    "ru"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/@homebridge/node-pty-prebuilt-multiarch/**",
    "agent/bench_ide_assisted.mjs"
  ],
  "extraMetadata": {
    "name": "yang-ide",
    "productName": "YANG IDE",
    "version": "1.0.0",
    "description": "YANG IDE — mustaqil ish stoli kod muharriri (AICOMP.UZ)",
    "main": "ide/main.js"
  },
  "files": [
    "ide/**/*",
    "!ide/test_*",
    "node_modules/@homebridge/node-pty-prebuilt-multiarch/build/**/*",
    "agent/**/*",
    "!agent/test_*",
    "!agent/bench_*",
    "agent/bench_ide_assisted.mjs",
    "agent/bench_score.js",
    "!agent/benchmark_*",
    "!agent/compare_*",
    "!agent/lru_ref/**",
    "!agent/*.md",
    "renderer/icon.ico",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "local-ai/lc",
      "to": "local-ai/lc"
    },
    {
      "from": "local-ai/model-qwen3.5-2b-q4_k_m.gguf",
      "to": "local-ai/model-qwen3.5-2b-q4_k_m.gguf"
    },
    {
      "from": "local-ai/catalog.json",
      "to": "local-ai/catalog.json"
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "renderer/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "YANG-IDE-Setup-${version}.${ext}",
    "deleteAppDataOnUninstall": false,
    "shortcutName": "YANG IDE"
  },
  "portable": {
    "artifactName": "YANG-IDE-Portable-${version}.${ext}"
  }
}
