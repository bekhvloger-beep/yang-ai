{
  "name": "yang-ai",
  "version": "5.6.0",
  "description": "YANG AI by AICOMP.UZ — professional desktop agentic assistant",
  "type": "module",
  "main": "main.js",
  "author": "AICOMP.UZ",
  "scripts": {
    "vendor:ide": "node scripts/sync_ide_vendor.mjs",
    "prestart": "node scripts/sync_ide_vendor.mjs",
    "start": "electron .",
    "predist": "node scripts/sync_ide_vendor.mjs",
    "dist": "electron-builder --win --publish never",
    "predist:ide": "node scripts/sync_ide_vendor.mjs",
    "dist:ide": "electron-builder --win --publish never --config electron-builder.ide.json",
    "dist:release": "node scripts/build_and_release.mjs",
    "prestart:ide": "node scripts/sync_ide_vendor.mjs",
    "start:ide": "electron ide/main.js",
    "test:ide": "node ide/test_ide_contract.mjs",
    "test:ide:models": "electron ide/test_local_ai_models.cjs",
    "test:ide:git": "node ide/test_git_panel.mjs",
    "test:voice": "node agent/test_local_voice.mjs",
    "test:bench:score": "node agent/test_bench_score.mjs",
    "test:ai:manager": "node scripts/ui_models_manager.mjs",
    "test:ai:menu": "node scripts/ui_menu_row.mjs",
    "test:ide:modelsui": "node ide/test_local_ai_ui.mjs",
    "test:ide:pytypes": "electron ide/test_python_types.cjs",
    "test:ide:pydebug": "electron ide/test_python_debug.cjs",
    "test:ide:pkg": "node ide/test_ide_packaged.mjs",
    "test:desk": "node admin-desk/test_admin_desk.mjs",
    "test:modes": "node agent/test_modes_complex.mjs",
    "test:ide:e2e": "node ide/test_embedded_e2e.mjs",
    "test:ide:fix": "node ide/test_fix_loop_live.mjs",
    "release": "node scripts/publish_release.mjs",
    "test:pin": "node agent/test_pin_failover.mjs",
    "test:ui": "node scripts/ui_pin_test.mjs",
    "test:ai:catalog": "node agent/test_remote_catalog.mjs",
    "test:ai:code": "node agent/test_coding_mode.mjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.14.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "^6.8.9",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "34.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "uz.aicomp.yang",
    "productName": "YANG AI",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/build/**/*",
      "agent/**/*",
      "!agent/test_*",
      "!agent/bench_result.json",
      "!agent/lru_ref/**",
      "!agent/lru_tests.mjs",
      "renderer/**/*",
      "ide/**/*",
      "!ide/test_*",
      "!ide/*.md"
    ],
    "asarUnpack": [
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "extraResources": [
      {
        "from": "translator/server.py",
        "to": "translator/server.py"
      },
      {
        "from": "translator/model",
        "to": "translator-model"
      },
      {
        "from": "translator/runtime",
        "to": "translator-runtime"
      },
      {
        "from": "local-ai/model-1.7b.gguf",
        "to": "local-ai/model-1.7b.gguf"
      },
      {
        "from": "local-ai/lc",
        "to": "local-ai/lc"
      },
      {
        "from": "local-ai/catalog.json",
        "to": "local-ai/catalog.json"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "renderer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "YANG-AI-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "YANG-AI-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bekhvloger-beep",
        "repo": "yang-ai"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  }
}
